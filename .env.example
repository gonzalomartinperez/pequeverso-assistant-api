# Copy to .env.local for local overrides (gitignored). Every value has a safe development default;
# production values are injected by vps-ops/Coolify as environment variables and secrets.

# development | test | production. Production fails closed on unsafe settings.
ENVIRONMENT=development
ASSISTANT_ENABLED=true

# Model provider. `fixture` is deterministic and free; `openai` requires both flags below and a
# Pequeverso-only key from a separate OpenAI project (never the portfolio's key).
AI_PROVIDER=fixture
ALLOW_PAID_AI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low

# Budget design target (USD). Not a billing setting.
MONTHLY_BUDGET_USD=10.00
DAILY_BUDGET_USD=1.00
BUDGET_SAFETY_MARGIN=0.10

# Browser policy. The assistant web app calls /api on its own origin; list only that origin.
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SESSION_COOKIE_SECURE=false
SESSION_RETENTION_HOURS=24
# Reverse-proxy addresses whose X-Forwarded-For is trusted, e.g. ["10.0.0.0/8"].
TRUSTED_PROXY_CIDRS=[]
# HMAC key for pseudonymous client rate limiting (>= 32 chars in production; secret).
# CLIENT_HASH_KEY=

# Catalog: the bundled snapshot by default. CATALOG_URL enables a published storefront document.
# CATALOG_URL=https://pequeverso.com/assistant/catalog.v1.json
CATALOG_PRICE_MAX_AGE_HOURS=168

DATABASE_PATH=data/assistant.sqlite3
