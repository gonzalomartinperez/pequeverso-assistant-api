{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pequeverso.invalid/draft/blocks.schema.json",
  "title": "Pequeverso message blocks (DRAFT for contract 1.7, not published)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blocks"
  ],
  "properties": {
    "blocks": {
      "type": "array",
      "maxItems": 24,
      "contains": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "link_chip"
          }
        }
      },
      "minContains": 0,
      "maxContains": 3,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "text",
              "citation",
              "product_card",
              "resource_card",
              "link_chip",
              "fundamentos",
              "follow_ups",
              "notice",
              "feedback",
              "memory_prompt"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "text"
                }
              }
            },
            "then": {
              "$ref": "#/$defs/text"
            }
          },
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "citation"
                }
              }
            },
            "then": {
              "$ref": "#/$defs/citation"
            }
          },
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "product_card"
                }
              }
            },
            "then": {
              "$ref": "#/$defs/product_card"
            }
          },
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "resource_card"
                }
              }
            },
            "then": {
              "$ref": "#/$defs/resource_card"
            }
          },
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "link_chip"
                }
              }
            },
            "then": {
              "$ref": "#/$defs/link_chip"
            }
          },
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "fundamentos"
                }
              }
            },
            "then": {
              "$ref": "#/$defs/fundamentos"
            }
          },
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "follow_ups"
                }
              }
            },
            "then": {
              "$ref": "#/$defs/follow_ups"
            }
          },
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "notice"
                }
              }
            },
            "then": {
              "$ref": "#/$defs/notice"
            }
          },
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "feedback"
                }
              }
            },
            "then": {
              "$ref": "#/$defs/feedback"
            }
          },
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "memory_prompt"
                }
              }
            },
            "then": {
              "$ref": "#/$defs/memory_prompt"
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "plain": {
      "type": "string",
      "maxLength": 600,
      "pattern": "^[^<>]*$"
    },
    "url": {
      "type": "string",
      "pattern": "^https://[^\\s<>]+(?![\\s\\S])",
      "maxLength": 500
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "markdown_lite",
        "claims"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^b[0-9]+$"
        },
        "type": {
          "const": "text"
        },
        "markdown_lite": {
          "$ref": "#/$defs/markdown_lite"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "evidence_ids"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "url",
        "source_type",
        "icon_id",
        "origin"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^b[0-9]+$"
        },
        "type": {
          "const": "citation"
        },
        "title": {
          "$ref": "#/$defs/plain"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "source_type": {
          "enum": [
            "page",
            "doc",
            "repo",
            "code",
            "product",
            "official_help",
            "web"
          ]
        },
        "icon_id": {
          "$ref": "#/$defs/icon_id"
        },
        "origin": {
          "enum": [
            "first_party",
            "web"
          ]
        },
        "quote": {
          "$ref": "#/$defs/plain"
        },
        "path": {
          "$ref": "#/$defs/plain"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      }
    },
    "product_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "product_id",
        "name",
        "summary",
        "age_range",
        "image",
        "price",
        "url",
        "purchase_url",
        "kind",
        "disclosure"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^b[0-9]+$"
        },
        "type": {
          "const": "product_card"
        },
        "product_id": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/plain"
        },
        "summary": {
          "$ref": "#/$defs/plain"
        },
        "age_range": {
          "$ref": "#/$defs/plain"
        },
        "image": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "url",
            "width",
            "height",
            "alt"
          ],
          "properties": {
            "url": {
              "$ref": "#/$defs/url"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "alt": {
              "$ref": "#/$defs/plain"
            }
          }
        },
        "price": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "amount",
            "currency",
            "display",
            "note",
            "tax_note",
            "verified_at"
          ],
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]{2}$"
            },
            "currency": {
              "const": "USD"
            },
            "display": {
              "$ref": "#/$defs/plain"
            },
            "note": {
              "$ref": "#/$defs/plain"
            },
            "tax_note": {
              "$ref": "#/$defs/plain"
            },
            "verified_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
            }
          }
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "purchase_url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://[^\\s<>]+(?![\\s\\S])",
          "maxLength": 500
        },
        "disclosure": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 600,
          "pattern": "^[^<>]*$"
        },
        "kind": {
          "enum": [
            "core",
            "affiliate"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 600,
          "pattern": "^[^<>]*$"
        }
      }
    },
    "resource_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "resource_id",
        "title",
        "pages",
        "image"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^b[0-9]+$"
        },
        "type": {
          "const": "resource_card"
        },
        "resource_id": {
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/plain"
        },
        "pages": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "url",
            "width",
            "height",
            "alt"
          ],
          "properties": {
            "url": {
              "$ref": "#/$defs/url"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "alt": {
              "$ref": "#/$defs/plain"
            }
          }
        }
      }
    },
    "link_chip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "url",
        "kind",
        "icon_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^b[0-9]+$"
        },
        "type": {
          "const": "link_chip"
        },
        "label": {
          "$ref": "#/$defs/plain"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "kind": {
          "enum": [
            "contact",
            "cv",
            "repo",
            "demo",
            "support",
            "help"
          ]
        },
        "icon_id": {
          "$ref": "#/$defs/icon_id"
        }
      }
    },
    "fundamentos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "items",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^b[0-9]+$"
        },
        "type": {
          "const": "fundamentos"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "citation_id",
              "quote"
            ],
            "properties": {
              "citation_id": {
                "type": "string"
              },
              "quote": {
                "$ref": "#/$defs/plain"
              }
            }
          }
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "follow_ups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "items"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^b[0-9]+$"
        },
        "type": {
          "const": "follow_ups"
        },
        "items": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "$ref": "#/$defs/plain"
              }
            }
          }
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "code",
        "severity",
        "text_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^b[0-9]+$"
        },
        "type": {
          "const": "notice"
        },
        "code": {
          "enum": [
            "answer_replaced",
            "payment_data_refused",
            "contact_data_redacted",
            "language_unsupported",
            "web_unavailable",
            "memory_saved",
            "abstained"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "warning"
          ]
        },
        "text_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "message_id",
        "reasons"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^b[0-9]+$"
        },
        "type": {
          "const": "feedback"
        },
        "message_id": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "memory_prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "proposed_facts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^b[0-9]+$"
        },
        "type": {
          "const": "memory_prompt"
        },
        "proposed_facts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "value"
            ],
            "properties": {
              "key": {
                "enum": [
                  "audience_role",
                  "child_age_band",
                  "interests",
                  "verbosity"
                ]
              },
              "value": {
                "type": "string",
                "maxLength": 40
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "key"
                  ],
                  "properties": {
                    "key": {
                      "const": "audience_role"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "enum": [
                        "parent",
                        "educator",
                        "gift_buyer"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "key"
                  ],
                  "properties": {
                    "key": {
                      "const": "child_age_band"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "enum": [
                        "2-3",
                        "4-5",
                        "6-7"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "key"
                  ],
                  "properties": {
                    "key": {
                      "const": "verbosity"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "enum": [
                        "short",
                        "normal"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "key"
                  ],
                  "properties": {
                    "key": {
                      "const": "interests"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,39}$"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "markdown_lite": {
      "type": "string",
      "not": {
        "pattern": "<[A-Za-z/!]"
      }
    },
    "icon_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,40}$"
    }
  }
}
