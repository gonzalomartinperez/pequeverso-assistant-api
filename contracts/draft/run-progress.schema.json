{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pequeverso.invalid/draft/run-progress.schema.json",
  "title": "run.progress event (DRAFT for contract 1.7, not published)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schema_version",
    "run_id",
    "sequence",
    "timestamp",
    "phase"
  ],
  "properties": {
    "type": {
      "const": "run.progress"
    },
    "schema_version": {
      "const": "1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "phase": {
      "enum": [
        "understanding",
        "retrieving",
        "checking_web",
        "reading",
        "writing",
        "verifying"
      ]
    },
    "sources_found": {
      "type": "integer",
      "minimum": 0
    }
  }
}
