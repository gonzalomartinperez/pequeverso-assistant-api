{
  "openapi": "3.1.0",
  "info": {
    "title": "Pequeverso assistant API",
    "version": "1"
  },
  "paths": {
    "/api/v1/availability": {
      "get": {
        "summary": "Whether new questions are accepted",
        "operationId": "availability_api_v1_availability_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session": {
      "post": {
        "summary": "Open (restore or create) the caller-owned session",
        "operationId": "open_session_api_v1_session_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "201": {
            "description": "A new session was created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete the session and its whole conversation",
        "operationId": "delete_session_api_v1_session_delete",
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Csrf-Token"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/v1/messages": {
      "post": {
        "summary": "Ask a question; the answer streams as Server-Sent Events",
        "operationId": "post_message_api_v1_messages_post",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Idempotency-Key"
            }
          },
          {
            "name": "x-csrf-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Csrf-Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "See contracts/sse.schema.json.",
            "content": {
              "text/event-stream": {}
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/v1/runs/{run_id}/cancel": {
      "post": {
        "summary": "Cancel the caller's active run",
        "operationId": "cancel_run_api_v1_runs__run_id__cancel_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "x-csrf-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Csrf-Token"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AvailabilityOut": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "available",
              "unavailable"
            ],
            "title": "Status"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "assistant_disabled",
                  "catalog_unavailable",
                  "budget_exhausted"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "AvailabilityOut"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "English, for developers; localize from `code`."
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable",
          "request_id"
        ],
        "title": "ErrorBody"
      },
      "ErrorOut": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorOut"
      },
      "ImageOut": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "description": "Absolute https URL on the storefront origin."
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "alt": {
            "type": "string",
            "title": "Alt"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url",
          "width",
          "height",
          "alt"
        ],
        "title": "ImageOut"
      },
      "LimitsOut": {
        "properties": {
          "max_message_chars": {
            "type": "integer",
            "title": "Max Message Chars"
          },
          "messages_per_day": {
            "type": "integer",
            "title": "Messages Per Day"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "max_message_chars",
          "messages_per_day"
        ],
        "title": "LimitsOut"
      },
      "LinkOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "url"
        ],
        "title": "LinkOut"
      },
      "MessageIn": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Content"
          },
          "page": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "home",
                  "product",
                  "support"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Page",
            "description": "Storefront page the visitor is on, if embedded."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "content"
        ],
        "title": "MessageIn"
      },
      "MessageOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Plain text; may contain **bold** and \"- \" list lines. Render as text, never as HTML. Independently useful without the fields below."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "products": {
            "items": {
              "$ref": "#/components/schemas/ProductOut"
            },
            "type": "array",
            "title": "Products"
          },
          "resources": {
            "items": {
              "$ref": "#/components/schemas/ResourceOut"
            },
            "type": "array",
            "title": "Resources"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/LinkOut"
            },
            "type": "array",
            "title": "Links"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceOut"
            },
            "type": "array",
            "title": "Sources"
          },
          "follow_ups": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Follow Ups",
            "description": "Optional suggested next questions."
          },
          "notices": {
            "items": {
              "type": "string",
              "enum": [
                "answer_replaced",
                "payment_data_refused",
                "contact_data_redacted"
              ]
            },
            "type": "array",
            "title": "Notices"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "role",
          "content",
          "created_at"
        ],
        "title": "MessageOut"
      },
      "PriceOut": {
        "properties": {
          "amount": {
            "type": "string",
            "title": "Amount",
            "description": "Decimal string, e.g. \"14.99\".",
            "examples": [
              "14.99"
            ]
          },
          "currency": {
            "type": "string",
            "const": "USD",
            "title": "Currency"
          },
          "display": {
            "type": "string",
            "title": "Display",
            "description": "Customer-facing format, e.g. \"US$14,99\"."
          },
          "note": {
            "type": "string",
            "title": "Note",
            "description": "Local-currency explanation; show it next to the price."
          },
          "tax_note": {
            "type": "string",
            "title": "Tax Note"
          },
          "verified_at": {
            "type": "string",
            "format": "date-time",
            "title": "Verified At",
            "description": "When the storefront price was last confirmed."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "amount",
          "currency",
          "display",
          "note",
          "tax_note",
          "verified_at"
        ],
        "title": "PriceOut"
      },
      "ProductOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Authoritative storefront product id (slug)."
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "age_range": {
            "type": "string",
            "title": "Age Range"
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "Product page on the storefront (allowlisted)."
          },
          "purchase_url": {
            "type": "string",
            "title": "Purchase Url",
            "description": "Storefront purchase section; checkout itself stays in the store's flow."
          },
          "image": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PriceOut"
              },
              {
                "type": "null"
              }
            ],
            "description": "null when the price cannot be confirmed as current."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "summary",
          "age_range",
          "url",
          "purchase_url",
          "image",
          "price"
        ],
        "title": "ProductOut"
      },
      "ResourceOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "\"<product_id>/<resource_id>\"."
          },
          "product_id": {
            "type": "string",
            "title": "Product Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "pages": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pages"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "image": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "product_id",
          "title",
          "pages",
          "description",
          "image"
        ],
        "title": "ResourceOut"
      },
      "SessionOut": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1",
            "title": "Schema Version",
            "default": "1"
          },
          "csrf_token": {
            "type": "string",
            "title": "Csrf Token",
            "description": "Send as X-CSRF-Token on every mutation. Keep in memory only."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At",
            "description": "Sliding: extended by each question and each session open."
          },
          "created": {
            "type": "boolean",
            "title": "Created",
            "description": "True when this call created a new session."
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageOut"
            },
            "type": "array",
            "title": "Messages",
            "description": "Stored history, oldest first (bounded)."
          },
          "availability": {
            "$ref": "#/components/schemas/AvailabilityOut"
          },
          "limits": {
            "$ref": "#/components/schemas/LimitsOut"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "csrf_token",
          "expires_at",
          "created",
          "messages",
          "availability",
          "limits"
        ],
        "title": "SessionOut"
      },
      "SourceOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "url"
        ],
        "title": "SourceOut"
      }
    }
  }
}
