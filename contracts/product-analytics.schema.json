    "project": {
      "const": "pequeverso",
      "default": "pequeverso",
      "title": "Project",
      "type": "string"
    },
    "layout_revision": {
      "const": "pequeverso-v1",
      "default": "pequeverso-v1",
      "title": "Layout Revision",
      "type": "string"
    },
    "profile_source_revision": {
      "const": "88d6d0add414261e5ccf5bd3e2b21285e1a33179",
      "default": "88d6d0add414261e5ccf5bd3e2b21285e1a33179",
      "title": "Profile Source Revision",
      "type": "string"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    },
    "coverage": {
      "const": "received_events_only",
      "default": "received_events_only",
      "title": "Coverage",
      "type": "string"
    },
    "timezone": {
      "const": "UTC",
      "default": "UTC",
      "title": "Timezone",
      "type": "string"
    },
    "country_collection": {
      "default": "disabled",
      "enum": [
        "disabled",
        "trusted_proxy_header"
      ],
      "title": "Country Collection",
      "type": "string"
    },
    "retention_days": {
      "const": 93,
      "default": 93,
      "title": "Retention Days",
      "type": "integer"
    },
    "min_bucket": {
      "const": 3,
      "default": 3,
      "title": "Min Bucket",
      "type": "integer"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "selection": {
      "$ref": "#/$defs/SelectionOut"
    },
    "start": {
      "format": "date-time",
      "title": "Start",
      "type": "string"
    },
    "end": {
      "format": "date-time",
      "title": "End",
      "type": "string"
    },
    "partial": {
      "title": "Partial",
      "type": "boolean"
    },
    "first_observed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "First Observed At"
    },
    "last_observed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Last Observed At"
    },
    "totals": {
      "$ref": "#/$defs/Counts"
    },
    "daily": {
      "items": {
        "$ref": "#/$defs/Daily"
      },
      "maxItems": 31,
      "title": "Daily",
      "type": "array"
    },
    "countries": {
      "items": {
        "$ref": "#/$defs/Country"
      },
      "maxItems": 250,
      "title": "Countries",
      "type": "array"
    },
    "grid": {
      "$ref": "#/$defs/Grid"
    }
