{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Pequeverso API \u2014 observed runtime",
  "uid": "pequeverso-api-runtime",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "pequeverso",
    "application-owned",
    "not-a-production-certification"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "utc",
  "panels": [
    {
      "id": 1,
      "title": "Private scrape",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"pequeverso-assistant-api\"}",
          "legendFormat": "{{status_class}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Local readiness",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pequeverso_ready{job=\"pequeverso-assistant-api\"}",
          "legendFormat": "{{status_class}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Active runs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pequeverso_active_runs{job=\"pequeverso-assistant-api\"}",
          "legendFormat": "{{status_class}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Process RSS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pequeverso_process_rss_bytes{job=\"pequeverso-assistant-api\"}",
          "legendFormat": "{{status_class}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Enclosing cgroup memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pequeverso_cgroup_memory_current_bytes{job=\"pequeverso-assistant-api\"}",
          "legendFormat": "{{status_class}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "HTTP requests per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(pequeverso_http_requests_total{job=\"pequeverso-assistant-api\"}[5m]))",
          "legendFormat": "{{status_class}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "HTTP p95 duration including streams",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pequeverso_http_request_duration_seconds_bucket{job=\"pequeverso-assistant-api\"}[5m])))",
          "legendFormat": "{{status_class}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Recorded outcomes in trailing24h",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pequeverso_runs_window{job=\"pequeverso-assistant-api\"}",
          "legendFormat": "{{status_class}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "description": "Point-in-time readiness and sampled private process metrics. Gaps are unknown, not uptime. HTTP duration includes SSE lifetime; recorded outcomes may not cover the full24h. vps-ops owns import/deployment and calibrated alerts."
}
