    {"id": "ref-007", "group": "ref-hp", "split": "holdout", "turns": ["¿Qué es el número de transacción HP?"], "expect": {"retrieval": ["document:policy.guarantee", "document:support.route.2", "document:support.contact"], "outcome": "answer", "language": "es"}},
