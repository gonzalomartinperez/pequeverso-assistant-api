    {"id": "ref-003", "group": "ref-how", "split": "dev", "turns": ["¿Dónde solicito la devolución?"], "expect": {"retrieval": ["document:policy.guarantee", "document:support.route.2", "document:faq.grafismo-fonetico.03"], "outcome": "answer", "language": "es"}},
